export default function AnalyticsPage() {
  const [business, setBusiness] = useState<Business | null>(null);
  const [scans, setScans] = useState<ScanEvent[]>([]);
  const [feedback, setFeedback] = useState<Feedback[]>([]);
  const [actions, setActions] = useState<ImprovementAction[]>([]);

  const [period, setPeriod] = useState<PeriodKey>("30");

  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState("");
  const [actionLoading, setActionLoading] = useState<number | string | null>(null);

  useEffect(() => {
    cargarAnalytics();
  }, []);

  async function cargarAnalytics() {
    setLoading(true);
    setError("");

    try {
      const {
        data: { user },
      } = await supabase.auth.getUser();

      if (!user) {
        setError("No hay una sesiÃ³n iniciada.");
        return;
      }

      const { data: businessUser, error: businessUserError } =
        await supabase
          .from("business_users")
          .select("business_id")
          .eq("user_id", user.id)
          .single();

      if (businessUserError || !businessUser) {
        console.error(businessUserError);
        setError("No encontramos un negocio asociado a tu cuenta.");
        return;
      }

      const { data: businessData, error: businessError } = await supabase
        .from("businesses")
        .select("id, name, logo_url, business_type")
        .eq("id", businessUser.business_id)
        .single();

      if (businessError || !businessData) {
        console.error(businessError);
        setError("No pudimos cargar tu negocio.");
        return;
      }

      const { data: scanData, error: scanError } = await supabase
        .from("scan_events")
        .select("id, source, created_at, is_test")
        .eq("business_id", businessData.id)
        .eq("is_test", false)
        .order("created_at", { ascending: false });

      if (scanError) {
        console.error(scanError);
        setError("No pudimos cargar los datos de actividad.");
        return;
      }

      const { data: feedbackData, error: feedbackError } = await supabase
        .from("feedback")
        .select(
          "id, rating, message, created_at, scan_event_id, is_test"
        )
        .eq("business_id", businessData.id)
        .eq("is_test", false)
        .order("created_at", { ascending: false });

      if (feedbackError) {
        console.error(feedbackError);
        setError("No pudimos cargar las valoraciones.");
        return;
      }

      const { data: actionData, error: actionError } = await supabase
        .from("improvement_actions")
        .select(
          "id, business_id, title, description, source_type, source_key, status, priority, created_at, started_at, resolved_at"
        )
        .eq("business_id", businessData.id)
        .order("created_at", { ascending: false });

      if (actionError) {
        console.error(actionError);
        // Las acciones son una capa nueva. No bloqueamos Analytics
        // si todavÃ­a no existen datos.
      }

      setBusiness(businessData);
      setScans(scanData || []);
      setFeedback(feedbackData || []);
      setActions(actionData || []);
    } catch (err) {
      console.error(err);
      setError("OcurriÃ³ un error al cargar Analytics.");
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }

  async function refrescar() {
    setRefreshing(true);
    await cargarAnalytics();
  }

  async function crearAccion(signal: IntelligenceSignal) {
    if (!business) return;

    setActionLoading(signal.key);

    try {
      const existing = actions.find(
        (action) =>
          action.source_key === signal.key &&
          action.status !== "dismissed" &&
          action.status !== "resolved"
      );

      if (existing) {
        setActionLoading(null);
        return;
      }

      const { data, error: insertError } = await supabase
        .from("improvement_actions")
        .insert({
          business_id: business.id,
          title: `Revisar ${signal.title.toLowerCase()}`,
          description: buildActionDescription(signal),
          source_type: "intelligence",
          source_key: signal.key,
          priority:
            signal.status === "attention" ? "high" : "medium",
          status: "pending",
        })
        .select(
          "id, business_id, title, description, source_type, source_key, status, priority, created_at, started_at, resolved_at"
        )
        .single();

      if (insertError) {
        console.error(insertError);
        setError("No pudimos crear la acciÃ³n.");
        return;
      }

      if (data) {
        setActions((current) => [data, ...current]);
      }
    } finally {
      setActionLoading(null);
    }
  }

  async function actualizarAccion(
    action: ImprovementAction,
    nextStatus: ImprovementAction["status"]
  ) {
    setActionLoading(action.id);

    try {
      const updateData: Partial<ImprovementAction> = {
        status: nextStatus,
      };

      if (nextStatus === "in_progress" && !action.started_at) {
        updateData.started_at = new Date().toISOString();
      }

      if (nextStatus === "resolved") {
        updateData.resolved_at = new Date().toISOString();
      }

      const { data, error: updateError } = await supabase
        .from("improvement_actions")
        .update(updateData)
        .eq("id", action.id)
        .select(
          "id, business_id, title, description, source_type, source_key, status, priority, created_at, started_at, resolved_at"
        )
        .single();

      if (updateError) {
        console.error(updateError);
        setError("No pudimos actualizar la acciÃ³n.");
        return;
      }

      if (data) {
        setActions((current) =>
          current.map((item) =>
            item.id === action.id ? data : item
          )
        );
      }
    } finally {
      setActionLoading(null);
    }
  }

  const analytics = useMemo(() => {
    const now = new Date();
    const today = startOfDay(now);
    const tomorrow = addDays(today, 1);

    let currentStart: Date;

    if (period === "all") {
      const dates = [
        ...feedback.map((item) => new Date(item.created_at)),
        ...scans.map((item) => new Date(item.created_at)),
      ];

      currentStart =
        dates.length > 0
          ? startOfDay(
              new Date(
                Math.min(...dates.map((date) => date.getTime()))
              )
            )
          : today;
    } else {
      const days = Number(period);
      currentStart = addDays(today, -(days - 1));
    }

    const periodDays =
      period === "all"
        ? Math.max(
            1,
            Math.ceil(
              (tomorrow.getTime() - currentStart.getTime()) /
                86400000
            )
          )
        : Number(period);

    const previousStart =
      period === "all"
        ? null
        : addDays(currentStart, -periodDays);

    const currentFeedback = feedback.filter((item) => {
      const date = new Date(item.created_at);
      return date >= currentStart && date < tomorrow;
    });

    const previousFeedback = feedback.filter((item) => {
      if (!previousStart) return false;

      const date = new Date(item.created_at);

      return date >= previousStart && date < currentStart;
    });

    const currentScans = scans.filter((item) => {
      const date = new Date(item.created_at);
      return date >= currentStart && date < tomorrow;
    });

    const previousScans = scans.filter((item) => {
      if (!previousStart) return false;

      const date = new Date(item.created_at);

      return date >= previousStart && date < currentStart;
    });

    const feedbackTotal = currentFeedback.length;
    const comments = currentFeedback.filter((item) =>
      isUsefulComment(item.message)
    );

    const allComments = currentFeedback.filter(
      (item) =>
        typeof item.message === "string" &&
        item.message.trim().length > 0
    );

    const averageRating = average(
      currentFeedback.map((item) => item.rating)
    );

    const previousAverage = average(
      previousFeedback.map((item) => item.rating)
    );

    const change =
      averageRating !== null && previousAverage !== null
        ? Number(
            (averageRating - previousAverage).toFixed(1)
          )
        : null;

    const canCompare =
      period !== "all" &&
      currentFeedback.length >= 5 &&
      previousFeedback.length >= 5;

    const positiveCount = currentFeedback.filter(
      (item) => item.rating >= 4
    ).length;

    const neutralCount = currentFeedback.filter(
      (item) => item.rating === 3
    ).length;

    const criticalCount = currentFeedback.filter(
      (item) => item.rating <= 2
    ).length;

    const positivePercentage =
      feedbackTotal > 0
        ? Math.round((positiveCount / feedbackTotal) * 100)
        : 0;

    const neutralPercentage =
      feedbackTotal > 0
        ? Math.round((neutralCount / feedbackTotal) * 100)
        : 0;

    const criticalPercentage =
      feedbackTotal > 0
        ? Math.round((criticalCount / feedbackTotal) * 100)
        : 0;

    const distribution = [5, 4, 3, 2, 1].map((rating) => {
      const count = currentFeedback.filter(
        (item) => item.rating === rating
      ).length;

      return {
        rating,
        count,
        percentage:
          feedbackTotal > 0
            ? Math.round((count / feedbackTotal) * 100)
            : 0,
      };
    });

    const qrScans = currentScans.filter(
      (item) => item.source?.toLowerCase() === "qr"
    ).length;

    const nfcScans = currentScans.filter(
      (item) => item.source?.toLowerCase() === "nfc"
    ).length;

    const attributableFeedback = currentFeedback.filter(
      (item) => item.scan_event_id !== null
    ).length;

    const conversion =
      currentScans.length > 0
        ? Math.round(
            (attributableFeedback / currentScans.length) * 100
          )
        : 0;

    const previousAttributable = previousFeedback.filter(
      (item) => item.scan_event_id !== null
    ).length;

    const previousConversion =
      previousScans.length > 0
        ? Math.round(
            (previousAttributable / previousScans.length) * 100
          )
        : null;

    const comparison =
      canCompare && change !== null
        ? {
            available: true,
            change,
            direction:
              change > 0.1
                ? "up"
                : change < -0.1
                ? "down"
                : "stable",
          }
        : {
            available: false,
            change: null,
            direction: "unknown",
          };

    /*
     * -------------------------------------------------------
     * INTELLIGENCE
     *
     * A topic is never called a recurring problem from one
     * keyword match.
     *
     * signal:
     *   1 mention
     *
     * emerging:
     *   2 mentions
     *
     * attention:
     *   3+ mentions with at least 2 critical ratings
     *   OR 5+ mentions with negative average
     *
     * strength:
     *   2+ mentions with average >= 4
     * -------------------------------------------------------
     */

    const intelligenceSignals: IntelligenceSignal[] =
      intelligenceTopics
        .map((topic) => {
          const matchingComments = comments.filter((item) => {
            const message = item.message;

            if (!message) return false;

            const normalized = normalizeText(message);

            return topic.keywords.some((keyword) =>
              normalized.includes(keyword)
            );
          });

          if (matchingComments.length === 0) {
            return null;
          }

          const ratings = matchingComments.map(
            (item) => item.rating
          );

          const avg = average(ratings) ?? 0;

          const topicCriticalCount = matchingComments.filter(
            (item) => item.rating <= 2
          ).length;

          const topicPositiveCount = matchingComments.filter(
            (item) => item.rating >= 4
          ).length;

          const criticalRate =
            matchingComments.length > 0
              ? Math.round(
                  (topicCriticalCount /
                    matchingComments.length) *
                    100
                )
              : 0;

          let status: IntelligenceSignal["status"];

          if (
            matchingComments.length >= 3 &&
            topicCriticalCount >= 2
          ) {
            status = "attention";
          } else if (
            matchingComments.length >= 5 &&
            avg < 3.5
          ) {
            status = "attention";
          } else if (matchingComments.length >= 2) {
            status = "emerging";
          } else {
            status = "signal";
          }

          if (
            matchingComments.length >= 2 &&
            avg >= 4 &&
            topicPositiveCount >= 2
          ) {
            status = "strength";
          }

          const confidence =
            matchingComments.length >= 5
              ? "alta"
              : matchingComments.length >= 3
              ? "media"
              : "baja";

          return {
            key: topic.key,
            title: topic.title,
            description: topic.description,
            count: matchingComments.length,
            criticalCount: topicCriticalCount,
            positiveCount: topicPositiveCount,
            averageRating: avg,
