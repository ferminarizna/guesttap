      const secondHalf = dailySatisfaction.slice(midpoint);

      const firstAverage = average(
        firstHalf.map((item) => item.average)
      );

      const secondAverage = average(
        secondHalf.map((item) => item.average)
      );

      if (
        firstAverage !== null &&
        secondAverage !== null
      ) {
